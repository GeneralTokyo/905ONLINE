    {
      "parameters": {
        "jsCode": "// Assembles the transient Vapi assistant from the Settings node.\n// Vapi \"assistant-request\" docs: https://docs.vapi.ai/server-url/events\nconst cfg = $input.first().json;\nconst message = cfg.body?.message || {};\nconst fill = (text) => String(text || '')\n  .replaceAll('{company}', cfg.companyName || 'our company')\n  .replaceAll('{agent}', cfg.agentName || 'Sarah');\n\n// Phone numbers: keep digits and \"+\", then require E.164 (+ country code + number).\nconst e164 = (n) => {\n  const cleaned = String(n || '').replace(/[^\\d+]/g, '');\n  return /^\\+[1-9]\\d{6,14}$/.test(cleaned) ? cleaned : '';\n};\nconst modes = [\n  'blind-transfer',\n  'warm-transfer-say-message',\n  'warm-transfer-say-summary',\n  'warm-transfer-wait-for-operator-to-speak-first-and-then-say-message',\n  'warm-transfer-wait-for-operator-to-speak-first-and-then-say-summary',\n];\nconst mode = modes.includes(cfg.transferMode) ? cfg.transferMode : 'warm-transfer-say-summary';\n\nconst destination = (number, team, description) => {\n  const transferPlan = { mode };\n  if (mode.endsWith('say-message')) transferPlan.message = 'Incoming ' + team + ' call transferred from the AI assistant. Connecting you now.';\n  return {\n    type: 'number',\n    number,\n    description,\n    message: fill(cfg.transferMessage),\n    transferPlan,\n  };\n};\n\nconst supportNumber = e164(cfg.supportNumber);\nconst salesNumber = e164(cfg.salesNumber);\nconst destinations = [];\nif (supportNumber) destinations.push(destination(supportNumber, 'support', 'Support team: existing customers, problems with an order or account, billing, refunds, cancellations, and anyone in support mode who asks for a person.'));\nif (salesNumber) destinations.push(destination(salesNumber, 'sales', 'Sales team: new customers, quotes, pricing, discounts, upgrades, and anyone in sales mode who asks for a person.'));\n\nconst transferRules = destinations.length\n  ? 'Transfers: use the transferCall tool. Pick the support destination for support issues and the sales destination for buying or pricing, whatever mode you are in. Before transferring, confirm in one sentence what the caller needs so the team gets a good summary. Do not say anything after calling the tool.'\n  : 'Transfers are not available right now. If the caller wants a person, take their name, callback number and reason, and promise a call back within one business day.';\n\nconst systemPrompt = fill([\n  'You are {agent}, the friendly virtual receptionist for {company}, answering a live phone call.',\n  'Style: keep every reply to one or two short sentences. Never use lists, markdown, emojis or URLs. Ask one question at a time. If the caller interrupts you, stop, listen, and answer what they just said. Do not repeat yourself.',\n  'Routing: your greeting asks the caller to press 1 or say support, or press 2 or say sales. A keypad press reaches you as a message containing just the digit. 1 or support means SUPPORT mode. 2 or sales means SALES mode. If the caller presses another key, say it is not an option and repeat the two choices. If they just start describing their need, pick the mode yourself.',\n  cfg.supportPlaybook,\n  cfg.salesPlaybook,\n  transferRules,\n].join('\\n\\n'));\n\nconst tools = destinations.length ? [{ type: 'transferCall', destinations }] : [];\n\nconst assistant = {\n  name: 'Front Desk (n8n template)',\n  firstMessage: fill(cfg.greeting),\n  firstMessageMode: 'assistant-speaks-first',\n  keypadInputPlan: { enabled: true, timeoutSeconds: 2 },\n  model: {\n    provider: 'openai',\n    model: 'gpt-4o-mini',\n    temperature: 0.4,\n    messages: [{ role: 'system', content: systemPrompt }],\n    ...(tools.length ? { tools } : {}),\n  },\n  voice: { provider: '11labs', voiceId: cfg.voiceId || 'sarah', model: 'eleven_flash_v2_5' },\n  transcriber: { provider: 'deepgram', model: 'nova-3', language: 'en' },\n  stopSpeakingPlan: { numWords: 0, voiceSeconds: 0.2, backoffSeconds: 1 },\n  maxDurationSeconds: 900,\n  serverMessages: ['transfer-update', 'end-of-call-report'],\n  metadata: { source: 'n8n-ai-voice-agent-vapi-only' },\n};\n\nreturn [{\n  json: {\n    callerNumber: message.call?.customer?.number || message.customer?.number || 'unknown',\n    transfersEnabled: destinations.length > 0,\n    supportNumber: supportNumber || 'not set',\n    salesNumber: salesNumber || 'not set',\n    transferMode: mode,\n    response: { assistant },\n  },\n}];"
      },
